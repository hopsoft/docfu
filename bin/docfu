#!/usr/bin/env node

import {Command} from 'commander'
import {DocFuConfig} from '../lib/docfu-config.js'
import {theme} from '../lib/theme.js'

// commands
import init from '../lib/cli/init.js'
import stage from '../lib/cli/stage.js'
import build from '../lib/cli/build.js'

// Initialize global docfu (commands can override with their specific source/sandbox)
global.docfu = new DocFuConfig(process.cwd())

const program = new Command()

program
  .name('docfu')
  .description('Generate production-ready documentation websites from markdown')
  .version(docfu.packageData.version, '-v, --version', 'output version number')
  .usage('[options] <source>')
  .configureHelp({
    sortOptions: true,
    styleArgumentDescription: theme.tertiary,
    styleArgumentTerm: theme.secondary,
    styleCommandTerm: theme.vivid,
    styleOptionDescription: theme.tertiary,
    styleOptionTerm: theme.secondary,
    styleSubcommandDescription: theme.tertiary,
    styleSubcommandTerm: theme.vivid,
    styleTitle: theme.primary,
  })
  .configureOutput({
    outputError: (str, write) => write(theme.danger(str)),
  })

// Init command - create docfu.yml configuration
program
  .command('init')
  .description('Initialize DocFu configuration')
  .argument('[source]', 'path to markdown docs')
  .option('-s, --sandbox <path>', 'sandbox directory (default: .docfu)')
  .option('-f, --force', 'overwrite existing configuration without prompting')
  .action(async (source, options) => init(source, options))

// Stage command - process docs only (no build)
program
  .command('stage')
  .description('Stage documents for build')
  .argument('<source>', 'path to markdown docs')
  .option('-s, --sandbox <path>', 'sandbox directory (default: .docfu)')
  .action(async (source, options) => stage(source, options))

// Build command - stage and build static site
program
  .command('build')
  .description('Build documentation site')
  .argument('<source>', 'path to markdown docs')
  .option('-s, --sandbox <path>', 'sandbox directory (default: .docfu)')
  .action(async (source, options) => build(source, options))

// Preview command - stage, build, and serve locally
program
  .command('preview')
  .description('Preview documentation site locally')
  .argument('<source>', 'path to markdown docs')
  .option('-s, --sandbox <path>', 'sandbox directory (default: .docfu)')
  .option('-p, --port <number>', 'preview server port (default: 4321)', '4321')
  .option('--watch', 'watch for changes and rebuild')
  .action(async (source, options) => previewCommand(source, options))

// Add help examples
program.addHelpText(
  'after',
  `
${theme.primary('Examples:')}
  ${theme.tertiary('$')} docfu ./docs
  ${theme.tertiary('$')} docfu stage ./docs
  ${theme.tertiary('$')} docfu preview ./my-docs --port 3000
  ${theme.tertiary('$')} docfu build ./docs --sandbox /tmp/my-docs
`
)

// Parse and execute
program.parse()
